    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "node-fetch": "^3.3.2",
    "pdfjs-dist": "^4.6.82",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.11.0",
    "resend": "^3.4.0",
    "stripe": "^14.11.0"
